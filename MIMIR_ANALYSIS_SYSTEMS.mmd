flowchart LR
  %% Mimir analysis systems and production status
  subgraph DATA[Data sources]
    OHLCV["OHLCV candles\nopen high low close volume"]
    MACRO["Macro and market state\nVIX, FII/DII, regime, sectors"]
    NEWS["RSS news feeds\nYahoo Finance, Moneycontrol,\nEconomic Times, LiveMint, RBI, world"]
    MICRO["Microstructure and derivatives\nOFI, bid/ask imbalance, options OI"]
    DB["Postgres / historical snapshots\npoint-in-time sentiment"]
  end

  subgraph TS[TypeScript feature and transport layer]
    FE["Feature Engine\n32 ordered ranker features\nEMA, RSI, ATR, ADX, VWAP, ROC,\nvolatility, candlestick, FII/DII lag"]
    CLIENT["AI Client\n/inference/batch\n30s + 500ms/candidate\n120s cap; circuit breaker"]
    NATIVE["Native Math fallback\nwhen AI service unavailable\nor timeout/circuit open"]
  end

  subgraph PY[Python AI service :8001]
    TECH["Technical Pattern Engine\nDETERMINISTIC RULES\npatterns + momentum + volume + TA\nACTIVE"]
    CHRONOS["Chronos-Bolt-Small\namazon/chronos-bolt-small\n5-step quantiles: q10/q25/q50/q75/q90\nACTIVE when weights load"]
    CHRONOS_FB["Chronos fallback\nmomentum + mean reversion\n5-step synthetic quantiles\nDEGRADED MODE"]
    SENT["FinBERT\nProsusAI/finbert\nsentiment-analysis pipeline\nACTIVE when Transformers loads"]
    SENT_FB["Sentiment degradation\nkeyword-only geopolitical/political\nscoring; neutral if no signals"]
    RANKER["Learned ranker\nLightGBM Booster\n32 features; calibrated P(win)\nCOMMITTED ARTIFACT; ACTIVE"]
    RANKER_FB["Ranker fallback\nnull P(win); legacy composite\nwhen LightGBM/artifacts/width invalid"]
    CONFL["Regime confluence\nper-regime LightGBMClassifier\n6 inputs; probability x 100\nOPTIONAL; NO .pkl ARTIFACTS"]
    CONFL_FB["Confluence fallback\nweighted arithmetic blend\n0.35 tech / 0.20 pattern /\n0.15 Chronos / 0.10 RS / 0.10 sector / 0.10 sentiment"]
    RL["PPO RL agent\nMlpPolicy; 5 actions; 7-state input\nOPTIONAL; NO rl_model.zip"]
    RL_FB["RL fallback\nHOLD, confidence 0, adjustment 0"]
  end

  subgraph DEC[Decision and execution layer]
    COMPOSITE["Composite AI score 0-100\ntechnical 50 + Chronos 30 +\nconfidence 15 + sentiment 5\nworld crash penalty / OFI adjustment"]
    GATE["Signal generator\nranker gate max(0.58, metadata threshold)\ncommitted threshold = 0.63\n70/30 ranker-confidence blend"]
    RISK["Risk engine\nquarter-Kelly sizing when P(win) exists\nposition size, stop, max risk"]
    OUT["Accepted / rejected signals\ntrade ranking and execution"]
  end

  OHLCV --> FE
  MACRO --> FE
  MICRO --> FE
  OHLCV --> CLIENT
  FE --> CLIENT
  CLIENT --> PY
  CLIENT -. unavailable / timeout .-> NATIVE
  NATIVE --> GATE

  OHLCV --> TECH
  OHLCV --> CHRONOS
  CHRONOS -. load or inference failure .-> CHRONOS_FB
  NEWS --> SENT
  SENT -. load or runtime failure .-> SENT_FB
  MACRO --> SENT
  DB --> SENT
  FE --> RANKER
  RANKER -. artifact/dependency/width failure .-> RANKER_FB
  TECH --> COMPOSITE
  CHRONOS --> COMPOSITE
  CHRONOS_FB --> COMPOSITE
  SENT --> COMPOSITE
  SENT_FB --> COMPOSITE
  MACRO --> COMPOSITE
  MICRO --> COMPOSITE
  COMPOSITE --> CONFL
  CONFL -. no trained regime artifact .-> CONFL_FB
  CONFL --> GATE
  CONFL_FB --> GATE
  RANKER --> GATE
  RANKER_FB --> GATE
  GATE --> RISK
  RISK --> OUT

  OHLCV --> RL
  MACRO --> RL
  RL -. missing artifact .-> RL_FB
  RL --> OUT
  RL_FB --> OUT

  classDef source fill:#e8eef7,stroke:#375a7f,color:#111,stroke-width:1px;
  classDef active fill:#d9f2df,stroke:#26733f,color:#111,stroke-width:2px;
  classDef fallback fill:#fff0d6,stroke:#a66a00,color:#111,stroke-width:1px;
  classDef optional fill:#f3e4f5,stroke:#7a3e85,color:#111,stroke-width:1px,stroke-dasharray: 5 5;
  classDef decision fill:#dce8ff,stroke:#2854a6,color:#111,stroke-width:2px;

  class OHLCV,MACRO,NEWS,MICRO,DB source;
  class FE,CLIENT,TECH,CHRONOS,SENT,RANKER active;
  class NATIVE,CHRONOS_FB,SENT_FB,RANKER_FB,CONFL_FB,RL_FB fallback;
  class CONFL,RL optional;
  class COMPOSITE,GATE,RISK,OUT decision;

  linkStyle default stroke:#667085,stroke-width:1px;
  linkStyle 9,11,13,15,17,19,21 stroke:#b54708,stroke-width:1.5px,stroke-dasharray: 5 5;
  linkStyle 22,23,24,25 stroke:#b54708,stroke-width:1.5px,stroke-dasharray: 5 5;
  linkStyle 26,27 stroke:#b54708,stroke-width:1.5px,stroke-dasharray: 5 5;
  linkStyle 28,29 stroke:#b54708,stroke-width:1.5px,stroke-dasharray: 5 5;
  linkStyle 30 stroke:#b54708,stroke-width:1.5px,stroke-dasharray: 5 5;

  %% Legend
  LEGEND["Legend: green = active path\norange = deterministic fallback\npurple dashed = optional/inactive artifact"]
  class LEGEND source
