# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/upstox_bot

# Upstox API Configuration (Get from https://api-v2.upstox.com/)
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:5000/api/system/auth-callback

# Server Configuration
PORT=5000
NODE_ENV=development

# STRICTLY REQUIRED for remote API and WebSocket access.
# If you are exposing Mimir over a Cloudflare Tunnel or public IP, you MUST set this token.
UPSTOXBOT_ADMIN_TOKEN=

# Optional: comma-separated allowed origins for backend and AI service CORS.
AI_CORS_ORIGINS=http://localhost:5000

# Required in production: shared token used by the backend when calling the AI service.
AI_SERVICE_TOKEN=

# Optional: remote API rate limit for non-local clients.
UPSTOXBOT_RATE_LIMIT_WINDOW_MS=60000
UPSTOXBOT_RATE_LIMIT_MAX=120

# STRICTLY REQUIRED: encryption key for persisted API secrets/tokens.
# Keep it unchanged once secrets have been saved.
UPSTOXBOT_SECRET_KEY=replace_with_a_long_random_secret

# System-1 Decision Intelligence Engine (Laya / Jev)
# Default engine: "laya" (Convai Innovations, local RLCD), "jev" (TypeSafe AI cloud API), or "consensus" (highest accuracy dual-engine)
  # System-1 Decision Intelligence Engine
  #
  # "laya" is the only engine. "jev" was TypeSafe AI's managed *cloud* API and
  # "consensus" merged the two; both are retired, because this platform must
  # decide fully on its own, offline, with no third-party inference service in
  # the loop. A stale value is logged and ignored rather than honoured.
  SYSTEM1_ENGINE=laya
  LAYA_ENABLED=true

  # Load the real open-weight checkpoint (Apache-2.0, ~804 MB download).
  # false = deterministic RLCD surrogate: fast, no download, but NOT a neural
  # model. Every decision then comes from a hand-written formula, so
  # /health reports laya.mode "local_surrogate" instead of "laya_package".
  LAYA_LOAD_WEIGHTS=true

  # Checkpoint variant. "typed-decisions" is tuned for choice/score/noul
  # questions, which is exactly what a trading verdict is. The default
  # (english) checkpoint answers them but is not tuned for them.
  LAYA_SUBFOLDER=typed-decisions

  # Backend for the checkpoint. "cpu" everywhere: Windows has no Metal, so CPU
  # is the only option on this host. On Apple Silicon, "mps" is faster.
  LAYA_DEVICE=cpu

  # LAYA_MODEL_ID=convaiinnovations/laya
  # LAYA_MODEL_PATH=
  # LAYA_ONNX_PATH=   # exported ONNX graph, preferred over PyTorch when present

JEV_ENABLED=true
# TYPESAFE_API_KEY=
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# --- Jev cloud transport tuning (latency + resilience) ---
# Per-request deadline in ms. A System-1 pre-trade gate must fail fast, not wait
# out a long cloud timeout on every candidate. Tightens automatically on failure.
# TYPESAFE_TIMEOUT_MS=400
# Decision cache TTL in seconds. The scanner re-evaluates an unchanged symbol on
# every tick debounce, so a short TTL serves repeat states without a network hop.
# Set to 0 to disable. JEV_CACHE_TTL_S=2
# JEV_CACHE_MAX=512
# Consecutive cloud failures before the circuit breaker opens, and how long it
# stays open before probing for recovery. Without this, an outage costs
# timeout x candidates on every batch.
# JEV_BREAKER_FAILURES=3
# JEV_BREAKER_COOLDOWN_S=30
# Concurrent in-flight requests when a batch misses the cache.
# JEV_MAX_WORKERS=8
SYSTEM1_EVALUATE_ALL=false

# High-Precision Accuracy Gates
# Minimum learned ranker win probability floor (default: 0.62 for high-precision sniper mode)
RANKER_MIN_THRESHOLD=0.62

